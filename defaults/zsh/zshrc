# NOS interactive zsh: syntax highlighting, suggestions, and theme-colored `ls`.
# Bash remains the scripting shell. Terminals start this file via ~/.zshrc.

export NOS_PATH="${NOS_PATH:-$HOME/.local/share/nos}"
export PATH="./bin:$HOME/.local/bin:$NOS_PATH/bin:$PATH"
export EDITOR="${EDITOR:-nvim}"
export COLORTERM="${COLORTERM:-truecolor}"

# History
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=32768
SAVEHIST=$HISTSIZE
setopt inc_append_history share_history hist_ignore_dups hist_ignore_space

# Same listing colors as bash (theme truecolor, with a colored baseline).
# shellcheck disable=SC1091
source "$NOS_PATH/defaults/bash/colors"

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
if [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  # shellcheck disable=SC1091
  source /usr/share/doc/fzf/examples/key-bindings.zsh
fi

# shellcheck disable=SC1091
source "$NOS_PATH/defaults/bash/aliases"
# shellcheck disable=SC1091
source "$NOS_PATH/defaults/bash/functions"

__nos_git_branch() {
  local branch
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) \
    || branch=$(git rev-parse --short HEAD 2>/dev/null) \
    || return 0
  printf ' (%s)' "$branch"
}

: "${NOS_DIR_SGR:=1;94}"
: "${NOS_GIT_SGR:=1;95}"
NOS_DIR_COLOR=$'\e['"${NOS_DIR_SGR}"m
NOS_GIT_COLOR=$'\e['"${NOS_GIT_SGR}"m
NOS_RESET=$'\e[0m'
setopt prompt_subst
# Directory and git colors match this theme's ls colors. Branch is recomputed each prompt.
PROMPT="%{${NOS_DIR_COLOR}%}%1~%{${NOS_RESET}%}%{${NOS_GIT_COLOR}%}"'$(__nos_git_branch)'"%{${NOS_RESET}%} -> "

# Colored tab completion uses the same file colors as ls.
autoload -Uz compinit
compinit -u
zstyle ':completion:*:default' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Suggestions, then syntax highlighting (highlighting must be last).
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
if [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main)
if [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  ZSH_HIGHLIGHT_STYLES[command]='fg=green,bold'
  ZSH_HIGHLIGHT_STYLES[alias]='fg=cyan,bold'
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=cyan'
  ZSH_HIGHLIGHT_STYLES[path]='fg=blue,underline'
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=red,bold'
fi
