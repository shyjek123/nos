# Technicolor dreams
force_color_prompt=yes
color_prompt=yes

# Show: ~/path (branch*↑1↓2) ❯
# - always current directory (\w)
# - git branch / detached SHA when inside a repo
# - * dirty, ↑ ahead, ↓ behind upstream

__nos_git_prompt() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  local branch dirty marks ahead behind

  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
  if [[ -z "$branch" ]]; then
    branch=$(git describe --tags --exact-match 2>/dev/null \
      || git rev-parse --short HEAD 2>/dev/null) || return 0
  fi

  dirty=""
  if ! git diff --quiet --ignore-submodules --cached 2>/dev/null \
    || ! git diff --quiet --ignore-submodules 2>/dev/null \
    || [[ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ]]; then
    dirty="*"
  fi

  marks=""
  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
    behind=$(git rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
    [[ "${ahead:-0}" -gt 0 ]] && marks+="↑${ahead}"
    [[ "${behind:-0}" -gt 0 ]] && marks+="↓${behind}"
  fi

  printf ' (%s%s%s)' "$branch" "$dirty" "$marks"
}

__nos_prompt_command() {
  local gitbit arrow
  gitbit="$(__nos_git_prompt)"
  arrow=$'\uf0a9'
  # title = cwd; visible prompt = cwd + optional git + arrow
  PS1="\[\e]0;\w\a\]\[\e[1;36m\]\w\[\e[0m\]\[\e[1;35m\]${gitbit}\[\e[0m\] ${arrow} "
}

# Install / re-install at the front so later tools (mise, etc.) don't drop it.
__nos_install_prompt() {
  # strip any previous copies then prepend
  local cleaned="${PROMPT_COMMAND:-}"
  cleaned="${cleaned//__nos_prompt_command; /}"
  cleaned="${cleaned//; __nos_prompt_command/}"
  cleaned="${cleaned//__nos_prompt_command/}"
  cleaned="${cleaned##; }"
  cleaned="${cleaned%%; }"
  if [[ -n "$cleaned" ]]; then
    PROMPT_COMMAND="__nos_prompt_command; ${cleaned}"
  else
    PROMPT_COMMAND="__nos_prompt_command"
  fi
}

__nos_install_prompt
