# Technicolor dreams
force_color_prompt=yes
color_prompt=yes

# Directory name only + git branch (when inside a repo)
__nos_git_branch() {
  local branch
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) \
    || branch=$(git rev-parse --short HEAD 2>/dev/null) \
    || return 0
  printf ' (%s)' "$branch"
}

# Window title = full cwd; prompt = basename [branch] ->
# Directory and git colors are the same truecolor values `ls` uses for that theme.
: "${NOS_DIR_SGR:=1;94}"
: "${NOS_GIT_SGR:=1;95}"
PS1="\[\e]0;\w\a\]\[\e[${NOS_DIR_SGR}m\]\W\[\e[0m\]\[\e[${NOS_GIT_SGR}m\]\$(__nos_git_branch)\[\e[0m\] -> "
