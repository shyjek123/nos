if command -v mise &> /dev/null; then
  eval "$(mise activate bash)"
fi

if command -v zoxide &> /dev/null; then
  eval "$(zoxide init bash)"
fi

if command -v fzf &> /dev/null; then
  if [[ -f /usr/share/bash-completion/completions/fzf ]]; then
    source /usr/share/bash-completion/completions/fzf
  fi
  if [[ -f /usr/share/doc/fzf/examples/key-bindings.bash ]]; then
    source /usr/share/doc/fzf/examples/key-bindings.bash
  fi
fi

# Alacritty completions only if the file exists (never force a ~/alacritty source-build path)
if [[ -f /usr/share/bash-completion/completions/alacritty ]]; then
  # shellcheck disable=SC1091
  source /usr/share/bash-completion/completions/alacritty
elif [[ -f /usr/share/bash-completion/completions/alacritty.bash ]]; then
  # shellcheck disable=SC1091
  source /usr/share/bash-completion/completions/alacritty.bash
fi
