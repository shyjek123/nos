# Listing and search colors for every NOS theme.
#
# Codes are ANSI palette slots, not fixed hex, so each theme restyles them.
# Keep these hues apart in every theme's normal and bright rows:
#   red     31/91  archives, broken links, deletions
#   green   32/92  executables
#   yellow  33/93  source, documents, build files
#   blue    34/94  directories
#   magenta 35/95  images and video
#   cyan    36/96  symlinks and audio
#   90             dates and punctuation

# GNU ls, readline colored-stats, and eza extension matches.
export LS_COLORS="\
di=01;94:\
ln=01;96:\
or=01;91:\
ex=01;92:\
fi=37:\
pi=33:\
so=01;95:\
bd=01;93:\
cd=01;93:\
mi=01;91:\
*.zip=01;91:*.tar=01;91:*.tgz=01;91:*.gz=01;91:*.bz2=01;91:*.xz=01;91:*.7z=01;91:*.rar=01;91:*.zst=01;91:\
*.png=01;95:*.jpg=01;95:*.jpeg=01;95:*.gif=01;95:*.webp=01;95:*.svg=01;95:*.ico=01;95:\
*.mp4=3;01;95:*.mkv=3;01;95:*.webm=3;01;95:*.mov=3;01;95:\
*.mp3=01;96:*.flac=01;96:*.wav=01;96:*.ogg=01;96:\
*.pdf=33:*.md=01;93:*.markdown=01;93:*.txt=33:*.rst=33:\
*.rs=01;93:*.py=01;93:*.js=01;93:*.jsx=01;93:*.ts=01;93:*.tsx=01;93:*.go=01;93:\
*.c=01;93:*.h=01;93:*.cpp=01;93:*.hpp=01;93:*.java=01;93:*.rb=01;93:*.lua=01;93:*.zig=01;93:\
*.sh=01;93:*.bash=01;93:\
*.json=01;96:*.yaml=01;96:*.yml=01;96:*.toml=01;96:*.xml=01;96:*.ini=01;96:*.conf=01;96:\
*.lock=02:*.log=02"

# eza file-type roles for names that the extension list above does not cover.
export EZA_COLORS="\
di=1;94:\
ln=1;96:\
or=1;91:\
ex=1;92:\
fi=37:\
pi=33:\
so=1;95:\
bd=1;93:\
cd=1;93:\
mp=4;1;94:\
im=1;95:\
vi=3;1;95:\
mu=1;96:\
lo=1;96:\
cr=1;92:\
do=33:\
co=1;91:\
tm=2:\
cm=2;33:\
bu=4;1;93:\
sc=1;93:\
da=90:\
xx=90:\
ga=1;92:\
gm=1;94:\
gd=1;91:\
gi=2"

# Filename, line number, and match each get their own slot.
export GREP_COLORS="${GREP_COLORS:-mt=1;93:fn=1;94:ln=1;96:se=90}"
