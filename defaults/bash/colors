# Theme-matched truecolor listings. `ls` / eza / grep stay plain unless these
# are exported; the terminal palette alone does not color filenames.
# Values come from the active NOS theme (McLaren, Tokyo Night, ...).
export COLORTERM="${COLORTERM:-truecolor}"

__nos_colors="$("${NOS_PATH:-$HOME/.local/share/nos}/bin/nos-theme-colors" 2>/dev/null)" || true
if [[ -n "${__nos_colors}" ]]; then
  eval "${__nos_colors}"
fi
unset __nos_colors

# Filename, line number, and match each get their own slot.
export GREP_COLORS="${GREP_COLORS:-mt=1;93:fn=1;94:ln=1;96:se=90}"
