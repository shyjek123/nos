# File system. Colors come from defaults/bash/colors (truecolor, per theme).
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -lh --group-directories-first --icons=auto --color=auto'
  alias lt='eza --tree --level=2 --long --icons --git --color=auto'
else
  alias ls='ls --color=auto --group-directories-first'
  alias lt='ls --color=auto'
fi
alias lsa='ls -a'
alias lta='lt -a'
alias grep='grep --color=auto'
alias ff="fzf --preview 'batcat --style=numbers --color=always {}'"
alias fd='fdfind'
alias cd='z'

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
n() { if [ "$#" -eq 0 ]; then nvim .; else nvim "$@"; fi; }
alias g='git'
alias d='docker'
alias bat='batcat'
alias lzg='lazygit'
alias lzd='lazydocker'

# Git
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

# NOS / RE
alias gdb='pwndbg'
